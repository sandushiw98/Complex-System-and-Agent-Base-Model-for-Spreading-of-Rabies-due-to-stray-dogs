breed [stray-dogs stray-dog]
breed [pet-dogs pet-dog]
breed [pedestrians pedestrian]
breed [dog-owners dog-owner]
breed [officers officer]

turtles-own [
  infected?
  sterilized?
  vaccinated?
  health
  age
]

patches-own [
  is-food-source?
  is-shelter?
]

globals [
  rabies-cases-stray
  rabies-cases-pet
  rabies-cases-human
  total-sterilized
  total-adopted
]

to setup
  clear-all
  setup-environment
  setup-agents
  reset-ticks
end

to setup-environment
  ask patches [
    set pcolor green + 3
    set is-food-source? false
    set is-shelter? false
  ]
  
  ; Set up food sources (yellow)
  ask n-of (count patches * 0.05) patches [
    set pcolor yellow
    set is-food-source? true
  ]
  
  ; Set up shelters (brown)
  ask n-of (count patches * 0.05) patches [
    set pcolor brown
    set is-shelter? true
  ]
  
  ; Set up roads (black)
  ask patches with [pxcor mod 10 = 0 or pycor mod 10 = 0] [
    set pcolor black
  ]
end
