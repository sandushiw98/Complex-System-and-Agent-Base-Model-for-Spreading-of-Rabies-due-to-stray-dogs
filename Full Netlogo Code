breed [stray-dogs stray-dog]
breed [pet-dogs pet-dog]
breed [pedestrians pedestrian]
breed [dog-owners dog-owner]
breed [officers officer]

turtles-own [
  infected?
  sterilized?
  vaccinated?
  health
  age
]

patches-own [
  is-food-source?
  is-shelter?
]

globals [
  rabies-cases-stray
  rabies-cases-pet
  rabies-cases-human
  total-sterilized
  total-adopted
]

to setup
  clear-all
  setup-environment
  setup-agents
  reset-ticks
end

to setup-environment
  ask patches [
    set pcolor green + 3
    set is-food-source? false
    set is-shelter? false
  ]
  
  ; Set up food sources (yellow)
  ask n-of (count patches * 0.05) patches [
    set pcolor yellow
    set is-food-source? true
  ]
  
  ; Set up shelters (brown)
  ask n-of (count patches * 0.05) patches [
    set pcolor brown
    set is-shelter? true
  ]
  
  ; Set up roads (black)
  ask patches with [pxcor mod 10 = 0 or pycor mod 10 = 0] [
    set pcolor black
  ]
end

to setup-agents
  create-stray-dogs initial-stray-dogs [
    setxy random-xcor random-ycor
    set shape "dog"
    set color brown
    set size 1.5
    set infected? random-float 1 < initial-infection-rate
    set sterilized? false
    set health 100
    set age random 5
  ]

create-pet-dogs initial-pet-dogs [
    setxy random-xcor random-ycor
    set shape "dog"
    set color white
    set size 1.5
    set infected? false
    set vaccinated? random-float 1 < initial-vaccination-rate
    set health 100
    set age random 5
  ]

create-pedestrians number-of-pedestrians [
    setxy random-xcor random-ycor
    set shape "person"
    set color blue
    set size 2
    set infected? false
  ]

create-dog-owners number-of-dog-owners [
    setxy random-xcor random-ycor
    set shape "person"
    set color green
    set size 2
    set infected? false
  ]

create-officers number-of-officers [
    setxy random-xcor random-ycor
    set shape "person"
    set color red
    set size 2
  ]
end

to go
  move-agents
  interact
  spread-rabies
  sterilize-dogs
  reproduce-stray-dogs
  update-health
  update-globals
  tick
end

to move-agents
  ask turtles [
    if breed = stray-dogs [
      ifelse any? patches in-radius 3 with [is-food-source?]
        [ face min-one-of patches with [is-food-source?] [distance myself] ]
        [ rt random 50 - random 50 ]
    ]
    if breed = pet-dogs or breed = dog-owners [
      rt random 50 - random 50
    ]
    if breed = pedestrians [
      ifelse random-float 1 < 0.1
        [ face one-of patches with [pcolor = black] ]
        [ rt random 50 - random 50 ]
    ]
    if breed = officers [
      if random-float 1 < 0.1 [
        face min-one-of stray-dogs [distance myself]
      ]
    ]
    fd 1
  ]
end
